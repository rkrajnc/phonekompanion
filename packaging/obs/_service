<services>
  <!-- On the OBS server, not at build time, so it also works for Fedora, Debian and Ubuntu -->
  <!-- The release tag's source as phonekompanion-<version>.tar, the version from the tag -->
  <service name="tar_scm">
    <param name="url">https://github.com/rkrajnc/phonekompanion.git</param>
    <param name="scm">git</param>
    <param name="revision">v0.1.2</param>
    <param name="versionformat">@PARENT_TAG@</param>
    <param name="versionrewrite-pattern">v(.*)</param>
    <param name="filename">phonekompanion</param>
  </service>
  <service name="recompress">
    <param name="file">*.tar</param>
    <param name="compression">gz</param>
  </service>
  <!-- The version into the spec, the .dsc and debian.changelog -->
  <service name="set_version"/>
</services>
