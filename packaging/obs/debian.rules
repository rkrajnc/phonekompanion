# SPDX-License-Identifier: CC0-1.0

# The compiled QML uses Qt's private API, so the package fits only the Qt it was built with
QT_VERSION := $(shell dpkg-query -W -f='$${source:Upstream-Version}' qt6-declarative-dev | sed 's/+.*//')

# The kf6 sequence of pkg-kde-tools sets KDE's install directories, e.g. /etc/xdg for autostart
%:
	dh $@ --with kf6

override_dh_gencontrol:
	dh_gencontrol -- -Vqt6:PrivateAbi="qt6-declarative-private-abi (= $(QT_VERSION))"
