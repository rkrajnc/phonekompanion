[Desktop Entry]
Name=Phone Dialer
GenericName=Phone Calls
Comment=Call contacts and phone numbers through your phone
Exec=phonekompanion --dialer
Icon=call-start
Type=Application
Terminal=false
Categories=Qt;KDE;Network;Telephony;
StartupWMClass=phonekompanion
