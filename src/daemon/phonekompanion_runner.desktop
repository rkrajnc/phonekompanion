[Desktop Entry]
Name=Phone Kompanion
Comment=Open apps, the screen or the camera of your phone in windows on this computer, and call contacts and numbers through it
Type=Service
Icon=smartphone
X-KDE-PluginInfo-Author=Rok Krajnc
X-KDE-PluginInfo-Email=rok.krajnc@gmail.com
X-KDE-PluginInfo-Name=phonekompanion
X-KDE-PluginInfo-License=GPL
X-KDE-PluginInfo-EnabledByDefault=true
X-Plasma-API=DBus
X-Plasma-DBusRunner-Service=io.github.rkrajnc.phonekompaniond
X-Plasma-DBusRunner-Path=/runner
X-Plasma-Runner-Match-Regex=(?i)^(phone|call)\s
X-Plasma-Runner-Syntaxes=phone :q:;phone screen;phone camera;call :q:
X-Plasma-Runner-Syntax-Descriptions=Opens the phone app :q: in a window;Shows the phone's screen in a window;Shows the phone's camera in a window;Calls the contact or phone number :q: from this computer
